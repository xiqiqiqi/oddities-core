---
import BaseLayout from './BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import { getEntries, getSiteInfo } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  theme?: 'light' | 'dark';
  siteName?: string;
  tagline?: string;
  langSwitchHref: string;
  randomChannel?: string;
  image?: string;
  showProgress?: boolean;
}

const {
  title,
  description,
  lang = 'zh',
  theme = 'dark',
  siteName,
  tagline,
  langSwitchHref,
  randomChannel,
  image,
  showProgress = false,
} = Astro.props;

const site = getSiteInfo(lang);
const resolvedName = siteName || site.name;
const resolvedTagline = tagline || site.tagline;

const entries = getEntries();
const searchEntries = entries.map((entry) => ({
  href: lang === 'zh' ? entry.hrefZh : entry.hrefEn,
  channel: entry.channel,
  title: lang === 'zh' ? entry.titleZh : entry.titleEn,
  meta: `${lang === 'zh' ? entry.channelZh : entry.channelEn} · ${entry.era}`,
  haystack: [
    entry.titleZh,
    entry.titleEn,
    entry.summaryZh,
    entry.summaryEn,
    entry.tags.join(' '),
    entry.region,
    entry.regionEn,
  ].join(' '),
}));

const randomEntries = randomChannel
  ? searchEntries.filter((entry) => entry.channel === randomChannel)
  : searchEntries;
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  theme={theme}
  siteName={resolvedName}
  image={image}
  alternateHref={langSwitchHref}
>
  {showProgress && (
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  )}
  <Masthead
    siteName={resolvedName}
    tagline={resolvedTagline}
    lang={lang}
    langSwitchHref={langSwitchHref}
  />
  <main>
    <slot />
  </main>
  <Footer lang={lang} siteName={resolvedName} siteTagline={resolvedTagline} />
  <MobileTabBar lang={lang} />
  <SearchOverlay entries={searchEntries} lang={lang} />

  <div hidden>
    {randomEntries.map((entry) => <a data-random-link href={entry.href}></a>)}
  </div>
</BaseLayout>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 300;
    height: 2px;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 80ms linear;
  }
</style>
