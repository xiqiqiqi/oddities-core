---
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  theme?: 'light' | 'dark';
  siteName?: string;
  image?: string;
  alternateHref?: string;
  schemaType?: 'WebPage' | 'Article' | 'CollectionPage';
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = '',
  lang = 'zh',
  theme = 'dark',
  siteName = '稀奇奇',
  image,
  alternateHref,
  schemaType = 'WebPage',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const base = Astro.site || Astro.url;
const canonical = new URL(Astro.url.pathname, base).href;
const alternate = alternateHref ? new URL(alternateHref, base).href : null;
const ogImage = image ? new URL(image, base).href : null;
const alternateLang = lang === 'zh' ? 'en' : 'zh-CN';
const selfLang = lang === 'zh' ? 'zh-CN' : 'en';
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const ogLocaleAlternate = lang === 'zh' ? 'en_US' : 'zh_CN';
const licenseUrl = 'https://creativecommons.org/licenses/by-sa/4.0/';
const schema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: title,
  description,
  url: canonical,
  inLanguage: selfLang,
  ...(ogImage ? { image: ogImage } : {}),
  isPartOf: {
    '@type': 'WebSite',
    name: siteName,
    url: new URL('/', base).href,
  },
  ...(schemaType === 'Article'
    ? {
        headline: title,
        mainEntityOfPage: canonical,
        author: { '@type': 'Organization', name: siteName },
        publisher: { '@type': 'Organization', name: siteName },
      }
    : {}),
};
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme={theme} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternate && <link rel="alternate" hreflang={alternateLang} href={alternate} />}
    <link rel="alternate" hreflang={selfLang} href={canonical} />
    <link rel="license" href={licenseUrl} />
    <link rel="icon" href="/assets/rhino.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="theme-color" content={theme === 'dark' ? '#12100E' : '#F3EEE4'} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {image && <link rel="preload" as="image" href={image} fetchpriority="high" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <script type="application/ld+json" set:html={schemaJson} />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('xiqiqi-theme');
          if (theme) document.documentElement.setAttribute('data-theme', theme);
        } catch (error) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />

    <script is:inline>
      (function () {
        function isElement(value) {
          return value && value.nodeType === 1;
        }

        document.addEventListener('click', function (event) {
          var target = isElement(event.target) ? event.target.closest('[data-theme-toggle]') : null;
          if (!target) return;

          var root = document.documentElement;
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);

          try {
            localStorage.setItem('xiqiqi-theme', next);
          } catch (error) {}
        });

        var overlay = document.querySelector('[data-search-overlay]');
        var input = document.querySelector('[data-search-input]');
        var closeButtons = document.querySelectorAll('[data-search-close]');
        var openButtons = document.querySelectorAll('[data-search-open]');
        var empty = document.querySelector('[data-search-empty]');
        var searchReturnFocus = null;

        function filterSearch(query) {
          var keyword = String(query || '').trim().toLowerCase();
          var items = document.querySelectorAll('[data-search-item]');
          var visible = 0;

          Array.prototype.forEach.call(items, function (item) {
            var text = (item.getAttribute('data-search-text') || item.textContent || '').toLowerCase();
            var show = !keyword || text.indexOf(keyword) !== -1;
            item.hidden = !show;
            if (show) visible += 1;
          });

          if (empty) empty.hidden = visible !== 0;
        }

        function searchFocusable() {
          if (!overlay) return [];
          return Array.prototype.slice.call(
            overlay.querySelectorAll('button, [href], input, [tabindex]:not([tabindex="-1"])')
          ).filter(function (el) {
            return !el.hidden && el.getAttribute('aria-hidden') !== 'true';
          });
        }

        function toggleSearch(show) {
          if (!overlay) return;
          if (show && !overlay.hidden) return;
          if (!show && overlay.hidden) return;

          if (show) {
            searchReturnFocus = document.activeElement;
            overlay.hidden = false;
            document.body.style.overflow = 'hidden';
            if (input) {
              input.value = '';
              filterSearch('');
              input.focus();
            }
          } else {
            overlay.hidden = true;
            document.body.style.overflow = '';
            if (searchReturnFocus && typeof searchReturnFocus.focus === 'function') {
              searchReturnFocus.focus();
            }
            searchReturnFocus = null;
          }
        }

        if (openButtons.length) {
          Array.prototype.forEach.call(openButtons, function (button) {
            button.addEventListener('click', function () { toggleSearch(true); });
          });
        }

        if (closeButtons.length) {
          Array.prototype.forEach.call(closeButtons, function (button) {
            button.addEventListener('click', function () { toggleSearch(false); });
          });
        }

        if (input) input.addEventListener('input', function () { filterSearch(input.value); });

        if (overlay) {
          overlay.addEventListener('keydown', function (event) {
            if (event.key !== 'Tab' || overlay.hidden) return;

            var focusables = searchFocusable();
            if (!focusables.length) return;

            var first = focusables[0];
            var last = focusables[focusables.length - 1];
            if (event.shiftKey && document.activeElement === first) {
              event.preventDefault();
              last.focus();
            } else if (!event.shiftKey && document.activeElement === last) {
              event.preventDefault();
              first.focus();
            }
          });
        }

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && overlay && !overlay.hidden) {
            toggleSearch(false);
          }
        });

        var randomButtons = document.querySelectorAll('[data-random]');
        Array.prototype.forEach.call(randomButtons, function (randomButton) {
          randomButton.addEventListener('click', function () {
            var links = document.querySelectorAll('[data-random-link]');
            if (!links.length) return;
            var target = links[Math.floor(Math.random() * links.length)];
            window.location.href = target.getAttribute('href');
          });
        });

        function daySeed() {
          var now = new Date();
          var month = String(now.getMonth() + 1).padStart(2, '0');
          var day = String(now.getDate()).padStart(2, '0');
          return Number(String(now.getFullYear()) + month + day);
        }

        function mulberry32(seed) {
          var value = seed;
          return function () {
            value |= 0;
            value = (value + 0x6d2b79f5) | 0;
            var t = Math.imul(value ^ (value >>> 15), 1 | value);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }

        var walls = document.querySelectorAll('[data-wall]');
        Array.prototype.forEach.call(walls, function (wall) {
          var cards = Array.prototype.slice.call(wall.querySelectorAll('[data-wall-card]'));
          if (cards.length < 2) return;

          var random = mulberry32(daySeed());
          for (var i = cards.length - 1; i > 0; i -= 1) {
            var j = Math.floor(random() * (i + 1));
            var temp = cards[i];
            cards[i] = cards[j];
            cards[j] = temp;
          }

          Array.prototype.forEach.call(cards, function (card) {
            wall.appendChild(card);
          });
        });

        if ('serviceWorker' in navigator && location.protocol === 'https:') {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register('/sw.js').catch(function () {});
          });
        }

        var progress = document.querySelector('[data-reading-progress]');

        if (progress) {
          var updateProgress = function () {
            var max = document.documentElement.scrollHeight - window.innerHeight;
            var value = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
            progress.style.transform = 'scaleX(' + value + ')';
          };

          window.addEventListener('scroll', updateProgress, { passive: true });
          window.addEventListener('resize', updateProgress);
          updateProgress();
        }

        var proseImages = document.querySelectorAll('.entry-prose img');

        if (proseImages.length) {
          var lightbox = document.createElement('div');
          lightbox.className = 'image-lightbox';
          lightbox.hidden = true;
          lightbox.setAttribute('role', 'dialog');
          lightbox.setAttribute('aria-modal', 'true');
          lightbox.setAttribute(
            'aria-label',
            document.documentElement.lang === 'en' ? 'Image viewer' : '图片查看'
          );
          var closeLabel = document.documentElement.lang === 'en' ? 'Close ✕' : '关闭 ✕';
          lightbox.innerHTML = '<button type="button" class="image-lightbox-close" aria-label="' + closeLabel + '">' + closeLabel + '</button><img alt="">';
          document.body.appendChild(lightbox);

          var lightboxImage = lightbox.querySelector('img');
          var lightboxClose = lightbox.querySelector('button');
          var lightboxReturnFocus = null;

          function closeLightbox() {
            if (lightbox.hidden) return;
            lightbox.hidden = true;
            document.body.style.overflow = '';
            if (lightboxReturnFocus && typeof lightboxReturnFocus.focus === 'function') {
              lightboxReturnFocus.focus();
            }
            lightboxReturnFocus = null;
          }

          Array.prototype.forEach.call(proseImages, function (img) {
            img.tabIndex = 0;
            img.setAttribute('role', 'button');
            img.setAttribute('aria-haspopup', 'dialog');
            img.setAttribute(
              'aria-label',
              (document.documentElement.lang === 'en' ? 'View larger image' : '查看大图') +
                (img.alt ? ': ' + img.alt : '')
            );
            img.addEventListener('click', function () {
              lightboxReturnFocus = document.activeElement;
              lightboxImage.src = img.currentSrc || img.src;
              lightboxImage.alt = img.alt || '';
              lightbox.hidden = false;
              document.body.style.overflow = 'hidden';
              if (lightboxClose) lightboxClose.focus();
            });
            img.addEventListener('keydown', function (event) {
              if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                img.click();
              }
            });
          });

          lightbox.addEventListener('click', function (event) {
            var target = event.target;
            if (target === lightbox || (isElement(target) && target.classList.contains('image-lightbox-close'))) {
              closeLightbox();
            }
          });

          lightbox.addEventListener('keydown', function (event) {
            if (event.key === 'Tab') {
              event.preventDefault();
              if (lightboxClose) lightboxClose.focus();
            }
          });

          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
          });
        }
      })();
    </script>
  </body>
</html>
