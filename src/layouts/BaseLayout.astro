---
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  theme?: 'light' | 'dark';
}

const { title, description = '', lang = 'zh', theme = 'dark' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-theme={theme} data-lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('xiqiqi-theme');
          if (theme) document.documentElement.setAttribute('data-theme', theme);
          var lang = localStorage.getItem('xiqiqi-lang');
          if (lang) document.documentElement.setAttribute('data-lang', lang);
        } catch (error) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />

    <script is:inline>
      (function () {
        function isElement(value) {
          return value && value.nodeType === 1;
        }

        document.addEventListener('click', function (event) {
          var target = isElement(event.target) ? event.target.closest('[data-theme-toggle]') : null;
          if (!target) return;

          var root = document.documentElement;
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);

          try {
            localStorage.setItem('xiqiqi-theme', next);
          } catch (error) {}
        });

        var overlay = document.querySelector('[data-search-overlay]');
        var input = document.querySelector('[data-search-input]');
        var openButton = document.querySelector('[data-search-open]');
        var closeButton = document.querySelector('[data-search-close]');
        var empty = document.querySelector('[data-search-empty]');

        function filterSearch(query) {
          var keyword = String(query || '').trim().toLowerCase();
          var items = document.querySelectorAll('[data-search-item]');
          var visible = 0;

          Array.prototype.forEach.call(items, function (item) {
            var text = (item.getAttribute('data-search-text') || item.textContent || '').toLowerCase();
            var show = !keyword || text.indexOf(keyword) !== -1;
            item.hidden = !show;
            if (show) visible += 1;
          });

          if (empty) empty.hidden = visible !== 0;
        }

        function toggleSearch(show) {
          if (!overlay) return;
          overlay.hidden = !show;
          document.body.style.overflow = show ? 'hidden' : '';

          if (show && input) {
            input.value = '';
            filterSearch('');
            input.focus();
          }
        }

        if (openButton) openButton.addEventListener('click', function () { toggleSearch(true); });
        if (closeButton) closeButton.addEventListener('click', function () { toggleSearch(false); });
        if (input) input.addEventListener('input', function () { filterSearch(input.value); });

        document.addEventListener('keydown', function (event) {
          if (event.key === 'Escape') toggleSearch(false);
        });

        var menuButton = document.querySelector('[data-menu-toggle]');
        var mobileNav = document.querySelector('[data-mobile-nav]');

        if (menuButton && mobileNav) {
          menuButton.addEventListener('click', function () {
            var isOpen = mobileNav.classList.toggle('is-open');
            menuButton.setAttribute('aria-expanded', String(isOpen));
          });
        }

        var randomButton = document.querySelector('[data-random]');
        if (randomButton) {
          randomButton.addEventListener('click', function () {
            var links = document.querySelectorAll('[data-random-link]');
            if (!links.length) return;
            var target = links[Math.floor(Math.random() * links.length)];
            window.location.href = target.getAttribute('href');
          });
        }

        function daySeed() {
          var now = new Date();
          var month = String(now.getMonth() + 1).padStart(2, '0');
          var day = String(now.getDate()).padStart(2, '0');
          return Number(String(now.getFullYear()) + month + day);
        }

        function mulberry32(seed) {
          var value = seed;
          return function () {
            value |= 0;
            value = (value + 0x6d2b79f5) | 0;
            var t = Math.imul(value ^ (value >>> 15), 1 | value);
            t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
            return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
          };
        }

        var walls = document.querySelectorAll('[data-wall]');
        Array.prototype.forEach.call(walls, function (wall) {
          var cards = Array.prototype.slice.call(wall.querySelectorAll('[data-wall-card]'));
          if (cards.length < 2) return;

          var random = mulberry32(daySeed());
          for (var i = cards.length - 1; i > 0; i -= 1) {
            var j = Math.floor(random() * (i + 1));
            var temp = cards[i];
            cards[i] = cards[j];
            cards[j] = temp;
          }

          Array.prototype.forEach.call(cards, function (card) {
            wall.appendChild(card);
          });
        });
      })();
    </script>
  </body>
</html>
