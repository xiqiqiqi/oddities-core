---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  kicker?: string;
  meta?: string;
  title: string;
  summary?: string;
  image?: string;
  imageAlt?: string;
  href?: string;
  ctaLabel?: string;
  stats?: Stat[];
}

const {
  kicker,
  meta,
  title,
  summary,
  image,
  imageAlt = '',
  href,
  ctaLabel = '阅读全文',
  stats = [],
} = Astro.props;
---

<section class="hero">
  {image && <img class="hero-bg" src={image} alt={imageAlt} />}
  <div class="hero-shade"></div>
  <div class="container hero-inner">
    {kicker && <p class="kicker">{kicker}</p>}
    {meta && <p class="hero-meta">{meta}</p>}
    <h1>{title}</h1>
    {summary && <p class="hero-summary">{summary}</p>}
    {href && <a class="btn-primary" href={href}>{ctaLabel} ↗</a>}
    {stats.length > 0 && (
      <dl class="hero-stats">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--night);
    color: var(--night-fg);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(10, 9, 8, 0.94) 0%, rgba(10, 9, 8, 0.35) 58%, rgba(10, 9, 8, 0.18) 100%),
      linear-gradient(90deg, rgba(10, 9, 8, 0.6) 0%, transparent 62%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    padding-top: 120px;
    padding-bottom: 72px;
  }

  .hero-meta {
    margin: 10px 0 0;
    color: rgba(243, 238, 228, 0.56);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin: 18px 0 24px;
    color: var(--night-fg);
    font-family: var(--serif);
    font-size: clamp(64px, 8.6vw, 132px);
    font-weight: 600;
    line-height: 0.96;
    letter-spacing: -0.05em;
    text-wrap: balance;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.35);
  }

  .hero-summary {
    max-width: 620px;
    color: rgba(243, 238, 228, 0.72);
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.95;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.4);
  }

  .btn-primary {
    margin-top: 26px;
    border-color: var(--amber);
    background: var(--amber);
    color: #1d1a17;
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 42px;
    margin: 42px 0 0;
    padding-top: 18px;
    border-top: 1px solid rgba(243, 238, 228, 0.22);
  }

  .hero-stats dt {
    color: rgba(243, 238, 228, 0.52);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-stats dd {
    margin: 4px 0 0;
    color: var(--night-fg);
    font-family: var(--serif);
    font-size: 20px;
  }

  @media (max-width: 720px) {
    .hero {
      min-height: 74vh;
    }

    .hero-inner {
      padding-top: 90px;
      padding-bottom: 52px;
    }

    .hero-summary {
      font-size: 16px;
    }

    .hero-stats {
      gap: 24px;
      margin-top: 30px;
    }

    .hero-stats dd {
      font-size: 17px;
    }
  }
</style>
