---
interface WallItem {
  href: string;
  image: string;
  alt?: string;
  meta?: string;
  title: string;
  ratio?: 'wide' | 'tall' | 'portrait' | 'square';
}

interface Props {
  items: WallItem[];
}

const { items = [] } = Astro.props;
---

<section class="wall" data-wall aria-label="档案图片墙">
  {items.map((item, index) => (
    <a class={`wall-card wall-card--${item.ratio || 'wide'}`} href={item.href} data-wall-card>
      <img
        src={item.image}
        alt={item.alt || ''}
        loading={index < 3 ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="wall-overlay">
        {item.meta && <div class="wall-meta">{item.meta}</div>}
        <h3>{item.title}</h3>
      </div>
    </a>
  ))}
</section>

<style>
  .wall {
    width: 100%;
    padding: 22px var(--gutter) 48px;
    columns: 3;
    column-gap: 18px;
    background: var(--paper);
  }

  .wall-card {
    position: relative;
    display: block;
    break-inside: avoid;
    margin: 0 0 18px;
    overflow: hidden;
    background: var(--night);
    border: 1px solid var(--line);
  }

  .wall-card img {
    width: 100%;
    display: block;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .wall-card--wide img { aspect-ratio: 16 / 9; }
  .wall-card--tall img { aspect-ratio: 3 / 4; }
  .wall-card--portrait img { aspect-ratio: 4 / 5; }
  .wall-card--square img { aspect-ratio: 1 / 1; }

  .wall-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 9, 8, 0.88) 0%, rgba(10, 9, 8, 0.18) 55%, transparent 78%);
    pointer-events: none;
  }

  .wall-card:hover img {
    transform: scale(1.045);
  }

  .wall-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 22px;
    color: var(--night-fg);
  }

  .wall-meta {
    margin-bottom: 6px;
    color: var(--amber);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--night-fg);
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .wall-card--wide h3 { font-size: 30px; }
  .wall-card--tall h3 { font-size: 27px; }
  .wall-card--square h3 { font-size: 22px; }

  @media (max-width: 1080px) {
    .wall { columns: 2; }
  }

  @media (max-width: 680px) {
    .wall {
      columns: 1;
      padding: 14px var(--gutter) 32px;
    }

    .wall-card { margin-bottom: 14px; }
    .wall-overlay { padding: 18px; }
  }
</style>
