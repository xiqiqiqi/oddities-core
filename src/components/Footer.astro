---
import { getChannelHref, getChannels } from '../lib/content';
import { getSiteMode } from '../lib/site';
import { ui } from '../lib/i18n';

interface Props {
  lang?: 'zh' | 'en';
  siteName?: string;
  siteTagline?: string;
}

const {
  lang = 'zh',
  siteName = '稀奇奇',
  siteTagline,
} = Astro.props;
const copy = ui(lang).footer;
const channels = getChannels();
const channelMode = getSiteMode() === 'channel';
const portalHref = lang === 'en' ? 'https://xiqiqi.com/en/' : 'https://xiqiqi.com/';
const aboutHref = lang === 'en' ? '/en/about/' : '/about/';
const legalHref = lang === 'en' ? '/en/legal/' : '/legal/';
const repoUrl = 'https://github.com/xiqiqiqi/oddities-and-mysteries';
const issuesUrl = `${repoUrl}/issues/new?template=correction.md`;
const netcnHref = 'https://netcn.org/';
const netcnLabel = lang === 'zh' ? '导航 · netcn.org' : 'Nav · netcn.org';
const netcnTitle = lang === 'zh' ? 'netcn.org · 简洁导航' : 'netcn.org · Simple web directory';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <div class="footer-brand">
        <img src="/assets/rhino.svg" alt="" width="44" height="44" />
        <div>
          <h3>{siteName}</h3>
          <p class="footer-tagline">{siteTagline || copy.tagline}</p>
          <p>{copy.description}</p>
          <a class="footer-ext" href={netcnHref} title={netcnTitle} aria-label={netcnTitle}>
            <span>{netcnLabel}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="footer-nav">
        <div class="footer-group">
          <h4>{copy.explore}</h4>
          <div class="footer-links">
            {channelMode && <a href={portalHref}>{lang === 'zh' ? '稀奇奇' : 'XIQIQI'}</a>}
            {channels.map((channel) => (
              <a href={getChannelHref(channel, lang)}>
                {lang === 'zh' ? channel.zh : channel.en}
              </a>
            ))}
          </div>
        </div>

        <div class="footer-group">
          <h4>{copy.site}</h4>
          <div class="footer-links">
            <a href={aboutHref}>{copy.aboutSite}</a>
            <a href={legalHref}>{copy.legal}</a>
            <a href={issuesUrl}>{copy.corrections}</a>
            <a href={repoUrl}>{copy.github}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>{copy.license}</p>
      <p>© 2026 XIQIQI · MADE FOR THE CURIOUS</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 58px 0 28px;
    background: var(--night);
    color: var(--night-fg);
  }

  .footer-main {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }

  .footer-brand {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .footer-brand h3 {
    margin: 0 0 8px;
    font-family: var(--serif);
    font-size: 24px;
  }

  .footer-tagline {
    color: var(--amber) !important;
    font-family: var(--serif);
    font-size: 14px;
  }

  .footer-brand p {
    max-width: 440px;
    margin: 0 0 10px;
    color: rgba(243, 238, 228, 0.64);
    font-size: 12px;
    line-height: 1.8;
  }

  .footer-ext {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: rgba(243, 238, 228, 0.58);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    transition: color 160ms ease;
  }

  .footer-ext:hover {
    color: var(--amber);
  }

  .footer-nav {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: 28px;
  }

  .footer-group {
    min-width: 0;
  }

  .footer-group h4 {
    margin: 0 0 10px;
    color: var(--amber);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
  }

  .footer-links a {
    color: rgba(243, 238, 228, 0.72);
    font-size: 12px;
    line-height: 1.7;
    transition: color 160ms ease;
  }

  .footer-links a:hover {
    color: var(--amber);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-top: 44px;
    padding-top: 20px;
    border-top: 1px solid rgba(243, 238, 228, 0.16);
    color: rgba(243, 238, 228, 0.42);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.04em;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (max-width: 860px) {
    .footer-main {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .footer-nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer-nav {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
