---
import { ui } from '../lib/i18n';

interface Props {
  lang?: 'zh' | 'en';
  siteName?: string;
}

const { lang = 'zh', siteName = '稀奇奇' } = Astro.props;
const copy = ui(lang).footer;
const portalHref = lang === 'en' ? 'https://xiqiqi.com/en/' : 'https://xiqiqi.com/';
const legalHref = lang === 'en' ? '/en/legal/' : '/legal/';
const repoUrl = 'https://github.com/xiqiqiqi/oddities-and-mysteries';
const issuesUrl = `${repoUrl}/issues/new?template=correction.md`;
const netcnHref = 'https://netcn.org/';
const netcnTitle = lang === 'zh' ? 'netcn.org · 简洁导航' : 'netcn.org · Simple web directory';
---

<footer class="site-footer">
  <div class="container footer-line">
    <p class="footer-site">
      {siteName} · <a href={portalHref}>xiqiqi.com</a>
    </p>
    <nav class="footer-links" aria-label={lang === 'zh' ? '页脚导航' : 'Footer navigation'}>
      <a href={issuesUrl}>{copy.report}</a>
      <span aria-hidden="true">·</span>
      <a href={legalHref}>{copy.legal}</a>
      <span aria-hidden="true">·</span>
      <a href={netcnHref} title={netcnTitle} aria-label={netcnTitle}>{copy.nav}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 22px 0;
    background: var(--night);
    color: var(--night-fg);
  }

  .footer-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px 18px;
    flex-wrap: wrap;
  }

  .footer-site,
  .footer-links {
    margin: 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  .footer-site {
    color: rgba(243, 238, 228, 0.46);
  }

  .footer-site a {
    color: rgba(243, 238, 228, 0.58);
    transition: color 160ms ease;
  }

  .footer-site a:hover {
    color: var(--amber);
  }

  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px 9px;
    color: rgba(243, 238, 228, 0.32);
  }

  .footer-links a {
    color: rgba(243, 238, 228, 0.58);
    transition: color 160ms ease;
  }

  .footer-links a:hover {
    color: var(--amber);
  }

  @media (max-width: 520px) {
    .site-footer {
      padding: 18px 0;
    }

    .footer-line {
      justify-content: flex-start;
      gap: 4px 12px;
    }
  }
</style>
