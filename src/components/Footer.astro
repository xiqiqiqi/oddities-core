---
import { ui } from '../lib/i18n';

interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;
const copy = ui(lang).footer;
const portalHref = lang === 'en' ? 'https://xiqiqi.com/en/' : 'https://xiqiqi.com/';
const legalHref = lang === 'en' ? '/en/legal/' : '/legal/';
const repoUrl = 'https://github.com/xiqiqiqi/oddities-and-mysteries';
const issuesUrl = `${repoUrl}/issues`;
const licenseUrl = 'https://creativecommons.org/licenses/by-sa/4.0/';
const year = new Date().getFullYear();
const licenseTitle = lang === 'zh'
  ? '文字与原创插图采用 CC BY-SA 4.0；代码采用 MIT'
  : 'Text and original illustrations under CC BY-SA 4.0; code under MIT';
---

<footer class="site-footer">
  <div class="container footer-line">
    <p class="footer-meta">
      <a href={portalHref}>xiqiqi.com</a>
      <span aria-hidden="true">·</span>
      <span>{year}</span>
      <span aria-hidden="true">·</span>
      <a href={licenseUrl} target="_blank" rel="license noopener" title={licenseTitle}>CC BY-SA 4.0</a>
    </p>
    <nav class="footer-links" aria-label={lang === 'zh' ? '页脚导航' : 'Footer navigation'}>
      <a href={issuesUrl}>{copy.report}</a>
      <span aria-hidden="true">·</span>
      <a href={legalHref}>{copy.legal}</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    padding: 22px 0;
    background: var(--night);
    color: var(--night-fg);
  }

  .footer-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 18px;
    flex-wrap: wrap;
  }

  .footer-meta,
  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 3px 9px;
    margin: 0;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1.6;
  }

  .footer-meta {
    color: rgba(243, 238, 228, 0.52);
  }

  .footer-meta a,
  .footer-links a {
    color: rgba(243, 238, 228, 0.58);
    transition: color 160ms ease;
  }

  .footer-meta a:hover,
  .footer-links a:hover {
    color: var(--amber-text);
  }

  .footer-links {
    color: rgba(243, 238, 228, 0.32);
  }

  @media (max-width: 520px) {
    .site-footer {
      padding: 18px 0;
    }

    .footer-line {
      justify-content: flex-start;
      gap: 4px 14px;
    }
  }
</style>
