---
import type { SourceItem } from '../lib/content';

interface Props {
  sources: SourceItem[];
  title?: string;
  lang?: 'zh' | 'en';
}

const { sources = [], title = '来源台账', lang = 'zh' } = Astro.props;
const labels = lang === 'zh'
  ? { pub: '作者 / 机构', use: '用途', lic: '许可', count: (n: number) => `共 ${n} 条 · 逐条列出` }
  : { pub: 'Author / Institution', use: 'Use', lic: 'License', count: (n: number) => `${n} sources · listed in full` };
---

<section class="source-ledger">
  <div class="ledger-heading">
    <h2>{title}</h2>
    <p class="ledger-count">{labels.count(sources.length)}</p>
  </div>
  <div class="ledger-grid">
    {sources.map((source) => (
      <article class="ledger-item">
        <div class="ledger-top">
          <span class="ledger-id">{source.id}</span>
          <span class="ledger-year">{source.year}</span>
        </div>
        <a class="ledger-title" href={source.url} target="_blank" rel="noopener">{source.title}</a>
        <p class="ledger-field">
          <span class="ledger-label">{labels.pub}</span>
          {source.publisher}
        </p>
        <p class="ledger-field">
          <span class="ledger-label">{labels.use}</span>
          {source.usage}
        </p>
        <p class="ledger-lic">
          <span class="ledger-label">{labels.lic}</span>
          <span class="ledger-chip">{source.license}</span>
        </p>
      </article>
    ))}
  </div>
</section>

<style>
  .source-ledger {
    margin-top: 56px;
    padding-top: 28px;
    border-top: 2px solid var(--ink);
  }

  .ledger-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 18px;
    margin-bottom: 18px;
  }

  h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: 26px;
  }

  .ledger-count {
    margin: 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .ledger-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: 14px;
  }

  .ledger-item {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 0;
    padding: 14px 16px 16px;
    border: 1px solid var(--line);
    border-top: 2px solid var(--line-strong);
    border-radius: 3px;
    background: var(--paper-2);
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .ledger-item:hover {
    transform: translateY(-2px);
    border-color: var(--line-strong);
    background: var(--paper-3);
  }

  .ledger-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }

  .ledger-id {
    color: var(--rust);
    font-family: var(--mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .ledger-year {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 10px;
    white-space: nowrap;
  }

  .ledger-title {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 15px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 160ms ease, color 160ms ease;
  }

  .ledger-title:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .ledger-title:focus-visible {
    outline: 2px solid var(--amber);
    outline-offset: 3px;
  }

  .ledger-field {
    margin: 0;
    color: var(--ink-2);
    font-family: var(--sans);
    font-size: 11.5px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .ledger-label {
    display: block;
    margin-bottom: 2px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .ledger-lic {
    margin: auto 0 0;
    padding-top: 2px;
  }

  .ledger-chip {
    display: inline-block;
    padding: 3px 8px;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    background: var(--amber-soft);
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .ledger-grid {
      gap: 10px;
    }

    .ledger-item {
      padding: 12px 13px 14px;
    }
  }
</style>