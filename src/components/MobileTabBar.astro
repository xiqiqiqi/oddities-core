---
import { getChannelHref, getChannels, getSiteInfo } from '../lib/content';

interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;

const site = getSiteInfo(lang);
const channels = getChannels();
const portalHref = lang === 'en' ? 'https://xiqiqi.com/en/' : 'https://xiqiqi.com/';

const labels = lang === 'zh'
  ? { nav: '移动端导航', mainSite: '主站' }
  : { nav: 'Mobile navigation', mainSite: 'Main' };
---

<nav class="mobile-tabs" aria-label={labels.nav}>
  <a
    class:list={['tab', site.mode === 'portal' && 'is-active']}
    href={portalHref}
    aria-current={site.mode === 'portal' ? 'page' : undefined}
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="8"></circle>
      <path d="M4 12h16"></path>
      <path d="M12 4c2.6 2.4 2.6 13.6 0 16"></path>
      <path d="M12 4c-2.6 2.4-2.6 13.6 0 16"></path>
    </svg>
    <span>{labels.mainSite}</span>
  </a>

  {channels.map((channel) => (
    <a
      class:list={['tab', site.channel === channel.id && 'is-active']}
      href={getChannelHref(channel, lang)}
      aria-current={site.channel === channel.id ? 'page' : undefined}
    >
      {channel.id === 'mystery' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M9.6 9.4a2.6 2.6 0 1 1 3.6 2.4c-.8.4-1.2 1-1.2 1.9"></path>
          <circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none"></circle>
        </svg>
      )}
      {channel.id === 'tales' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 6.5C10.4 5.3 8.3 4.8 5.5 5v12.8c2.8-.2 4.9.3 6.5 1.5 1.6-1.2 3.7-1.7 6.5-1.5V5c-2.8-.2-4.9.3-6.5 1.5Z"></path>
          <path d="M12 6.5v12.8"></path>
        </svg>
      )}
      {channel.id === 'objects' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4l7 6-7 10L5 10z"></path>
          <path d="M5 10h14"></path>
        </svg>
      )}
      {channel.id === 'places' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 21s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z"></path>
          <circle cx="12" cy="11" r="2.2"></circle>
        </svg>
      )}
      {channel.id === 'creatures' && (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="8" cy="8.5" r="1.7"></circle>
          <circle cx="12" cy="7" r="1.7"></circle>
          <circle cx="16" cy="8.5" r="1.7"></circle>
          <path d="M12 11c-3 0-5 2.2-5 4.3 0 1.5 1.2 2.7 2.7 2.7 1 0 1.6-.5 2.3-.5s1.3.5 2.3.5c1.5 0 2.7-1.2 2.7-2.7C17 13.2 15 11 12 11Z"></path>
        </svg>
      )}
      <span>{lang === 'zh' ? channel.zh : channel.en}</span>
    </a>
  ))}
</nav>

<style>
  .mobile-tabs {
    display: none;
  }

  @media (max-width: 920px) {
    .mobile-tabs {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 150;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 0;
      padding: 5px 4px calc(5px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--line);
      background: color-mix(in srgb, var(--paper) 92%, transparent);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .tab {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      min-width: 0;
      min-height: 50px;
      padding: 3px 1px;
      border: 0;
      border-radius: 12px;
      background: transparent;
      color: var(--muted);
      font-family: var(--sans);
      font-size: 9px;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: color 150ms ease, background 150ms ease;
      -webkit-tap-highlight-color: transparent;
    }

    .tab span {
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .tab svg {
      width: 19px;
      height: 19px;
      flex: none;
    }

    .tab.is-active {
      color: var(--amber);
      background: var(--amber-soft);
    }

    .tab:active {
      transform: scale(0.96);
    }
  }
</style>
