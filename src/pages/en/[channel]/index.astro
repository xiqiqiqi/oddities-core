---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import Hero from '../../../components/Hero.astro';
import ImageWall from '../../../components/ImageWall.astro';
import { entryWallMeta, getChannels, getEntriesByChannel } from '../../../lib/content';

export function getStaticPaths() {
  return getChannels().map((channel) => ({
    params: { channel: channel.route },
    props: { channel },
  }));
}

const { channel } = Astro.props;
const entries = getEntriesByChannel(channel.id);
const hero = entries[0];

const wallItems = entries.map((entry, index) => ({
  href: entry.hrefEn,
  image: entry.cover,
  alt: entry.titleEn,
  meta: entryWallMeta(entry, 'en'),
  title: entry.titleEn,
  ratio: (['wide', 'tall', 'square', 'portrait', 'wide'] as const)[index % 5],
}));
---

<SiteLayout
  title={`${channel.en} · ${channel.annotationEn} · XIQIQI`}
  description={channel.descriptionEn}
  lang="en"
  langSwitchHref={`/${channel.route}/`}
  randomChannel={channel.id}
>
  <Hero
    kicker={`${channel.en} · ${channel.annotationEn}`}
    meta={`${entries.length} entries`}
    title={channel.en}
    summary={channel.descriptionEn}
    image={hero?.cover}
    imageAlt={hero?.titleEn || channel.en}
  />

  {entries.length > 0 ? (
    <ImageWall items={wallItems} />
  ) : (
    <p class="empty">This channel is still being assembled.</p>
  )}
</SiteLayout>

<style>
  .empty {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px var(--gutter) 100px;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 20px;
  }
</style>
