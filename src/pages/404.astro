---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getSiteInfo } from '../lib/content';

const site = getSiteInfo('zh');
---

<SiteLayout
  title={`这一页不见了 · ${site.name}`}
  description="你打开的页面不存在，可能已经改名或被移走。"
  lang="zh"
  langSwitchHref="/en/"
>
  <section class="lost">
    <p class="kicker">404 / LOST PAGE</p>
    <h1>这一页不见了。</h1>
    <p class="lost-copy">
      你打开的地址没有对应的档案。可能它换了名字，也可能只是犀牛翻页时抖落了一角。
    </p>
    <div class="lost-actions">
      <a class="btn-primary" href="/">回首页 ↗</a>
      <a class="lost-link" href="/en/">English →</a>
    </div>
  </section>
</SiteLayout>

<style>
  .lost {
    min-height: 62vh;
    max-width: var(--max);
    margin: 0 auto;
    padding: 120px var(--gutter) 100px;
  }

  .lost h1 {
    margin: 16px 0 20px;
    font-family: var(--serif);
    font-size: clamp(48px, 7vw, 96px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .lost-copy {
    max-width: 520px;
    color: var(--muted);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.9;
  }

  .lost-actions {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 32px;
  }

  .btn-primary {
    border-color: var(--amber);
    background: var(--amber);
    color: #1d1a17;
  }

  .lost-link {
    color: var(--muted);
    font-size: 13px;
  }
</style>
